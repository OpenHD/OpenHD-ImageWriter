Section /o "Rockchip USB driver (Luckfox and X21)" RockusbDriver
  InitPluginsDir
  SetOutPath "$PLUGINSDIR"
  File "install-rockusb.ps1"
  DetailPrint "Downloading and installing the Rockchip USB driver..."
  ClearErrors
  ${DisableX64FSRedirection}
  ExecWait '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -ExecutionPolicy RemoteSigned -File "$PLUGINSDIR\install-rockusb.ps1"' $0
  ${EnableX64FSRedirection}
  ${If} ${Errors}
    StrCpy $0 1
  ${EndIf}
  ${If} $0 == 3010
    SetRebootFlag true
  ${ElseIf} $0 != 0
    DetailPrint "Rockchip USB driver setup did not complete."
    MessageBox MB_OK|MB_ICONEXCLAMATION "Rockchip USB driver setup did not complete. You can install it later with DriverAssistant from Luckfox's downloads page." /SD IDOK
  ${EndIf}
SectionEnd

