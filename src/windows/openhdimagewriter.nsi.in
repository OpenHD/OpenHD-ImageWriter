######################################################################

Function .onInit
!ifdef INNER
 
  ; If INNER is defined, then we aren't supposed to do anything except write out
  ; the uninstaller.  This is better than processing a command line option as it means
  ; this entire code path is not present in the final (real) installer.
  SetSilent silent
  !ifndef UNINSTALLER_OUTPUT
    !error "INNER requires UNINSTALLER_OUTPUT"
  !endif
  ClearErrors
  WriteUninstaller "${UNINSTALLER_OUTPUT}"
  IfErrors generator_failed
  SetErrorLevel 0
  Quit  ; just bail out quickly when running the "inner" installer
generator_failed:
  SetErrorLevel 1
  Quit
!else
  ${IfNot} ${AtLeastWin7}
    MessageBox MB_OK "$(win7Msg)"
    Quit
  ${EndIf}
  ${IfNot} ${AtLeastWin10}
    SectionSetFlags ${RockusbDriver} ${SF_RO}
    SectionSetText ${RockusbDriver} "Rockchip USB driver (requires Windows 10 or 11)"
  ${EndIf}
!endif
FunctionEnd
