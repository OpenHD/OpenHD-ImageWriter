<SBCConfig name="zero3w">
    <Property key="sbc" value="zero3w"/>
    <Property key="rock5" value="false"/>
    <Property key="rock3" value="true"/>
    <Property key="rpi" value="false"/>

    <Settings>
        <Group title="Camera Settings" visibleIf="bootType == 'Air'">
            <ComboBox key="camera">
                <Option text="NONE"/>
                <Option text="IMX462"/>
                <Option text="HDMI"/>
                <Option text="IMX219"/>
                <Option text="VEYE"/>
                <Option text="OV5647"/>
            </ComboBox>
        </Group>
    </Settings>
</SBCConfig>
