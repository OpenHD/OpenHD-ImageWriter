  "ipCamera": {
    "_comment": "Shown when primary or secondary camera type 3 (IP-CAMERA) is selected. Values are imported by openhd-sysutils and used as OpenHD's initial camera configuration.",
    "primaryAddressKey": "ip_camera_address",
    "primaryPipelineKey": "ip_camera_pipeline",
    "secondaryAddressKey": "camera2_ip_camera_address",
    "secondaryPipelineKey": "camera2_ip_camera_pipeline",
    "reservedBitrateKey": "ip_camera_bitrate_mbits",
    "defaultAddress": "192.168.144.108",
    "defaultPipeline": "rtspsrc location=rtsp://{IP}:554/stream=0 latency=0 ! rtph264depay",
    "reservedBitrateRangeMbits": [1, 20],
    "defaultReservedBitrateMbits": 2
  },
