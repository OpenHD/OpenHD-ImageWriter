!ifdef INNER
RequestExecutionLevel user
OutFile "ImageWriter-uninstaller-generator.exe"
!else
OutFile "${INSTALLER_NAME}"
!endif
BrandingText "${APP_NAME}"
XPStyle on
InstallDirRegKey "${REG_ROOT}" "${REG_APP_PATH}" ""
InstallDir "$PROGRAMFILES\OpenHD ImageWriter"

