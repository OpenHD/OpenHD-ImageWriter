{
  "_comment": "Machine-readable map of OpenHD advanced options, the UI categories that show them, and the FAT32 outputs written by downloadthread.cpp.",
  "_comment_use": "Programs can traverse each setting object to build menus and know which file/value is produced.",
  "useSettings": {
    "_comment": "Global gate: when true, all other files under openhd/ are written.",
    "files": [
      {
        "path": "openhd/*",
        "note": "All other setting files are only written when useSettings is true."
      }
    ]
  },
  "bootType": {
    "_comment": "Mutually exclusive Air/Ground flags that create marker files.",
    "options": [
      {
        "id": "Air",
        "file": "openhd/air.txt",
        "valueWritten": ""
      },
      {
        "id": "Ground",
        "file": "openhd/ground.txt",
        "valueWritten": ""
      }
    ]
  },
