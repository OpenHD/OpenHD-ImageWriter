#include <windows.h>
#include "imager_windows_version.h"

IDI_ICON1 ICON DISCARDABLE "../icons/openhdimagewriter.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "openhdimagewriter.manifest"

1 VERSIONINFO
FILEVERSION IMAGER_VERSION_CSV
PRODUCTVERSION IMAGER_VERSION_CSV
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904e4"
        {
            VALUE "CompanyName",     "OpenHD"
            VALUE "FileDescription", "OpenHD ImageWriter"
            VALUE "FileVersion",     IMAGER_RC_VERSION_STR
            VALUE "ProductName",     "OpenHD ImageWriter"
            VALUE "ProductVersion",  IMAGER_RC_VERSION_STR
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x409, 1252
    }
}
